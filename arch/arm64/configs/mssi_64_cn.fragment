CONFIG_USB_XHCI_PCI_RENESAS=y
# --- Source-built vendor modules (proof-of-loop; expand incrementally) ---
# MediaTek MT6397-family PMIC MFD + its RTC. Both are upstreamed in GKI
# common; build them as modules from source to replace the stock blobs
# (mt6397.ko, rtc-mt6397.ko). Deps resolve against GKI core symbols.
CONFIG_MFD_MT6397=m
CONFIG_RTC_DRV_MT6397=m
# Inert virtual netdev - zero-risk on-device KMI load test vehicle
CONFIG_DUMMY=m
# DuoQin/Agenew ODM trinket modules (clean-room recreations)
CONFIG_DUOQIN_BOARD_ID_GPIO_STATE=m
CONFIG_DUOQIN_SENSOR_PROBE=m
CONFIG_DUOQIN_ATA_TEST=m
